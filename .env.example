# Copy this file to ".env" (same folder) and change the values.
# .env holds secrets and is ignored by git. NEVER commit it.

# --- Backend ---
NODE_ENV=development
PORT=4000
# Which website is allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173

# --- Local database (used by docker-compose.yml) ---
POSTGRES_USER=solarskin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=solarskin

# Connection string the backend uses. Must match the three values above
# (or paste a Neon / Supabase connection string here instead).
DATABASE_URL=postgresql://solarskin:change_me@localhost:5432/solarskin
