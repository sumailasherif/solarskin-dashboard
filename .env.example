# Copy this file to ".env" (same folder) and fill in real values.
# .env holds secrets and is ignored by git. NEVER commit it.

# --- Backend ---
NODE_ENV=development
PORT=4000
# Which website is allowed to call the API from a browser
CORS_ORIGIN=http://localhost:5173

# --- Database (Neon, free hosted PostgreSQL) ---
# 1. Sign up at https://neon.tech and create a project (region: closest to you).
# 2. Dashboard → "Connect" → copy the connection string and paste it below.
#    It looks like: postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
