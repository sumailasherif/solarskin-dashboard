{
  "name": "@solarskin/simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Fergana sensor-data model + a 3-MacBook test dashboard (sensor kit · public website · home owner)",
  "type": "module",
  "scripts": {
    "dev": "vite --config dashboard/vite.config.ts",
    "build:dashboard": "vite build --config dashboard/vite.config.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p dashboard"
  },
  "dependencies": {
    "@solarskin/shared": "^0.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "i18next": "^27.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
