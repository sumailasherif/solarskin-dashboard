{
  // Shared TypeScript settings. Each package's tsconfig.json "extends" this file,
  // so every package follows the same strict rules.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true, // catch null/undefined mistakes early
    "noUncheckedIndexedAccess": true, // arr[i] might be undefined; make us check
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true // we never compile to JS ourselves: tsx (backend) and Vite (frontend) run TS directly
  }
}
